# db-ci:stable — image unique pour la CI de la base (db/).
# Sert à la fois :
#   - de SERVICE PostgreSQL 16 + PostGIS + pgTAP (extension côté serveur), et
#   - de CONTENEUR DE JOB outillé (make, psql, sqlx-cli, pg_prove).
# Construire & charger dans le runner DinD : ./ci/db/load-into-runner.sh
# (image locale, force_pull: false côté runner — comme flutter-ci / rust-ci).

# Pas de --platform forcé : l'image doit être construite NATIVEMENT sur la
# même architecture que le runner Forgejo qui l'exécutera ensuite (comme
# ci/rust/Containerfile et ci/flutter/Containerfile — "arm64-friendly",
# aucun --platform en dur), pas de cross-compilation ni d'émulation QEMU.
#
# 2026-07-22 : cette image était pinnée --platform=linux/amd64 (commentaire
# d'origine : "runners Forgejo amd64"), fausse pour CE cluster (le node k3s
# est arm64, Lima VM sur Apple Silicon, sans binfmt_misc enregistré pour
# l'émulation — un `docker run` d'une image amd64 échoue immédiatement avec
# `exec format error`, aucune émulation possible). D'où deux corrections :
# 1) image de base finale PostGIS remplacée par imresamu/postgis (multi-arch,
#    amd64 ET arm64 — l'officielle postgis/postgis ne publie QUE amd64,
#    https://github.com/ImreSamu/docker-postgis) ;
# 2) étape sqlx retirée de toute logique de cross-compilation : elle build
#    nativement, sur la même arch que l'image finale.
#
# --- étape build : sqlx-cli (natif, même arch que l'image finale) ---
FROM rust:1-bullseye AS sqlx
RUN cargo install sqlx-cli --version ^0.8 --no-default-features --features postgres,rustls --root /out

# --- image finale : PostGIS 16 + outils de test ---
# nodejs 22 obligatoire : Forgejo Actions exécute les actions JS
# (actions/checkout@v4 etc.) en appelant `node` DANS ce container — même
# contrainte que ci/rust/Containerfile et ci/flutter/Containerfile. Sans ça :
# "exec: node: executable file not found in $PATH" dès le premier step.
FROM imresamu/postgis:16-3.4
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends \
      nodejs \
      make \
      postgresql-16-pgtap \
      libtap-parser-sourcehandler-pgtap-perl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=sqlx /out/bin/sqlx /usr/local/bin/sqlx
RUN node --version && sqlx --version && pg_prove --version && make --version | head -1
