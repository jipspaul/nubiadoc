---
// Certains navigateurs ont encore un service worker enregistré par une
// ancienne PWA Flutter Web (back-office pré-migration Astro). Ce SW tente
// de fetch ses anciens assets (flutter_bootstrap.js, version.json, ...) qui
// n'existent plus côté serveur → TypeError: Failed to fetch non gérée
// (issue #3476). On désinscrit tout SW résiduel du domaine dès le chargement.
---

<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then((registrations) => {
      for (const registration of registrations) {
        registration.unregister();
      }
    });
  }
  if ('caches' in window) {
    caches.keys().then((keys) => {
      for (const key of keys) {
        caches.delete(key);
      }
    });
  }
</script>
