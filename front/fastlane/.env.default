# Contrat d'environnement pour la distribution mobile nubiadoc (fastlane).
# Copier en `.env` (gitignoré) et remplir, ou fournir via secrets CI.

# Testeurs Firebase App Distribution (emails séparés par des virgules).
FAD_TESTERS=xav.b00@gmail.com

# URL du backend injectée dans les builds (--dart-define=API_BASE_URL).
# Défaut Fastfile = prod déployée. Surcharger pour un autre environnement.
# Doit inclure le suffixe /v1.
API_BASE_URL=https://api.doc.nubia-link.com/v1
# Clé MapTiler (tuiles carto) — optionnelle.
# MAPTILER_KEY=

# Clé JSON du service account Firebase (rôle "Firebase App Distribution Admin").
# Requise en CI. En local, si absente, le plugin réutilise la session firebase CLI.
# GOOGLE_APPLICATION_CREDENTIALS=./fastlane/.secrets/nubiadoc-fastlane.json

# App IDs Android (surcharge optionnelle ; valeurs par défaut dans le Fastfile).
# FAD_APP_ID_PATIENT=1:117935898059:android:07899c13b5bfd928e38a4e
# FAD_APP_ID_PRATICIEN=1:117935898059:android:cb0c710257fce92ce38a4e
# FAD_APP_ID_SECRETARIAT=1:117935898059:android:13ec7bc7e17e0f7ce38a4e
# FAD_APP_ID_PHARMACIE=1:117935898059:android:4e60d5a536628076e38a4e
