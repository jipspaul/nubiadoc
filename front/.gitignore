# ==========================================================================
# Nubia Flutter monorepo (.gitignore)
# Applies to the pub workspace root + every package and app under it.
# ==========================================================================

# --- Dart / Flutter tooling & build output --------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
coverage/
doc/api/
.fvm/

# Single workspace lockfile (matches repo convention; regenerated by pub get)
pubspec.lock

# --- Generated code (build_runner: injectable / retrofit / json / freezed) -
*.config.dart
*.g.dart
# Exception : fichier Drift généré committé (CI ne lance pas build_runner)
!**/nubia_cache_db.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# --- iOS / macOS (generated by `flutter create` / CocoaPods) ---------------
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/Flutter/GeneratedPluginRegistrant.*
**/GeneratedPluginRegistrant.*
**/Pods/
**/.symlinks/
**/*.xcworkspace/xcuserdata/
**/xcuserdata/
**/DerivedData/

# --- Android (generated; none yet, but future-proof) ----------------------
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/app/debug/
**/android/app/release/
**/.cxx/

# --- Web -------------------------------------------------------------------
**/web/flutter_service_worker.js

# --- IDE / editor ----------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# --- OS junk ---------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Secrets / local env ---------------------------------------------------
*.env
.env.local

# --- fastlane / bundler (distribution mobile) ---
front/vendor/bundle/
vendor/bundle/
.bundle/
